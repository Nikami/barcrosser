# ============================================================
# BarCrosser Environment Variables
# Copy this file to .env and fill in real values.
# The .env file is NEVER committed to git.
# ============================================================

# ---- MongoDB ------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/barcrosser?retryWrites=true&w=majority

# ---- JWT ----------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ---- Server -------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200

# ---- Vercel (used in GitHub Actions CI/CD) ------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
